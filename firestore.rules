rules_version = '2';
// Firestore 보안 규칙 (사내 행사용 간이 설정)
// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 붙여넣고 게시(Publish).
service cloud.firestore {
  match /databases/{database}/documents {

    // 여러 퍼즐 문제. 누구나 읽기(참가자가 봐야 함). 쓰기는 간이 구성상 열어둠.
    match /puzzles/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // 진행 중 퍼즐 지정 등 설정값
    match /config/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // (구버전 호환) 단일 퍼즐 문서
    match /puzzle/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // 정답 제출 로그
    match /submissions/{doc} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.department is string;
      allow read: if true;    // 관리자/랭킹 화면 조회. 민감정보 없음(이름/소속).
      allow delete: if true;  // 관리자 '순위 초기화'에서 사용.
      allow update: if false;
    }
  }
}
